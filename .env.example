# Server
PORT=3000
NODE_ENV=development

# Database (SQLite for dev, switch to PostgreSQL URL for production)
DATABASE_URL="file:./aimee.db"

# Authentication
JWT_SECRET=change-this-to-a-real-secret-in-production
JWT_EXPIRY=24h

